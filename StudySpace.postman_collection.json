          "name": "Submit Quiz Attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"1\": \"FIFO\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/1/attempt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "1", "attempt"]
            }
