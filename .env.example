# StudySpace - Environment Configuration Example
# Copy this file to .env and customize as needed.

# Application Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# AI Service Configuration (OpenAI-compatible: OpenAI, Groq, Ollama, OpenRouter, etc.)
# If left blank, all non-AI features remain 100% operational, and AI features will display a helpful setup guide.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
