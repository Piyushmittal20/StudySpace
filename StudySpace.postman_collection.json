    {
      "name": "5. Flashcards & Spaced Repetition",
      "item": [
        {
          "name": "List Flashcards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/flashcards?due_only=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flashcards"],
              "query": [
                {
                  "key": "due_only",
                  "value": "false"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Flashcard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is Thrashing in Virtual Memory?\",\n  \"answer\": \"A state where the CPU spends more time paging than executing processes.\",\n  \"tag\": \"OS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/flashcards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flashcards"]
            }
          },
          "response": []
        },
        {
          "name": "Submit Flashcard Review (SM-2 Rating)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": \"good\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/flashcards/1/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flashcards", "1", "review"]
            }
          },
          "response": []
        }
