{
  "info": {
    "_postman_id": "studyspace-api-collection-v1",
    "name": "StudySpace API Collection",
    "description": "Comprehensive REST API test collection for StudySpace — Personal AI Learning Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health & Diagnostics",
      "item": [
        {
          "name": "Get Application Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Verifies that the backend is operational and SQLite database is connected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Subjects, Chapters & Topics",
      "item": [
        {
          "name": "Get Curriculum Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
