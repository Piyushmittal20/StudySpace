        {
          "name": "Toggle Topic Completion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subjects/topics/1/toggle-complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects", "topics", "1", "toggle-complete"]
