            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Computer Science\",\n  \"description\": \"Core systems, algorithms and architecture\",\n  \"color\": \"#4F46E5\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
