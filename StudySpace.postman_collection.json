              "raw": "{\n  \"title\": \"Memory Management Quiz\",\n  \"difficulty\": \"medium\",\n  \"questions\": [\n    {\n      \"question_type\": \"mcq\",\n      \"question_text\": \"Which page replacement algorithm suffers from Belady's anomaly?\",\n      \"options\": [\"FIFO\", \"LRU\", \"Optimal\", \"Clock\"],\n      \"correct_answer\": \"FIFO\",\n      \"explanation\": \"First-In-First-Out can exhibit Belady's anomaly where adding frames increases page faults.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            }
          },
          "response": []
