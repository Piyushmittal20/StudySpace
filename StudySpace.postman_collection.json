            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_id\": 1,\n  \"name\": \"Operating Systems\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects/chapters",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects", "chapters"]
            }
